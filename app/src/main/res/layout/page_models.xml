<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/prismBackground"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <!-- Header -->
    <TextView
        android:id="@+id/modelsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.8"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="4dp"
        android:text="Models"
        android:textColor="@color/white"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/modelsSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingBottom="12dp"
        android:text="Models imported to this device"
        android:textColor="@color/prism_text_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/modelsEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:text="No models imported yet. Import one from Settings → Local AI Model."
        android:textColor="@color/prism_text_muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/modelsRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="80dp" />
</LinearLayout>
